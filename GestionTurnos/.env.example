# ==============================================================================
# Configuración local de desarrollo - GestionTurnos
# ------------------------------------------------------------------------------
# 1. Copie este archivo:   cp .env.example .env
# 2. Complete los valores (pida la contraseña de la BD al equipo por un canal privado).
# 3. Ejecute:              ./setup-dev.sh        (Linux/macOS/Git Bash)
#                          .\setup-dev.ps1       (Windows PowerShell)
#
# El archivo .env está en .gitignore: NUNCA lo suba al repositorio.
# El script guarda estos valores en los user-secrets de su máquina.
# ==============================================================================

# --- Base de datos PostgreSQL (Supabase) ---
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<id-proyecto-supabase>
DB_PASSWORD=

# --- Primer administrador (opcional, solo si la BD aún no tiene uno) ---
# Si se completan, el script ejecuta "dotnet run -- seed-admin".
ADMIN_CORREO=
ADMIN_CONTRASENA=

# --- Correo SMTP (opcional) ---
# Si SMTP_USERNAME y SMTP_PASSWORD están completos, el script habilita el envío real de correos.
# Para Gmail use una "contraseña de aplicación" (16 caracteres, sin espacios), no la clave de la cuenta.
# Pida las credenciales al equipo por un canal privado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
