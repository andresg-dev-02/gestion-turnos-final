<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Optimización para no enviar cabeceras innecesarias -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      
      <!-- Handler para AspNetCoreModuleV2 -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      
      <!-- Configuración del módulo de ASP.NET Core en IIS -->
      <aspNetCore processPath="dotnet" arguments=".\GestionTurnos.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
      
      <!-- Reglas de seguridad adicionales (previene acceso a archivos y carpetas ocultas) -->
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment=".git" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>

