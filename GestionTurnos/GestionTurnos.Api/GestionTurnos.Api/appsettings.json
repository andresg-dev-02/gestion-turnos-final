{
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "MSSqlServer",
              "Args": {
                "connectionString": "DefaultConnection",
                "tableName": "Log",
                "schemaName": "Logging",
                "autoCreateSqlTable": false
              }
            }
          ]
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Key": "SuperSecretKeyParaTokensJwtMUYSEGURA2026!GestionTurnos2026",
    "Issuer": "GestionTurnosApi",
    "Audience": "AngularApp",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 60,
    "RefreshTokenSesionHoras": 12
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GestionTurnos;Trusted_Connection=True;TrustServerCertificate=True;Pooling=true;"
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "CommandTimeoutSeconds": 30,
    "EnableRetryOnFailure": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 10,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "DataProtection": {
    "ApplicationName": "GestionTurnos",
    "PersistToDatabase": true
  },
  "AppSettings": {
    "TimeZone": "America/Bogota",
    "PermitirAsistenciaSinTurno": false,
    "MinutosMinimosEntreMarcaciones": 5,
    "HorasMargenCierreTurno": 4,
    "HorasMaximasJornadaSinTurno": 16
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "CarpetaFotosPerfil": "gestion-turnos/perfiles",
    "TamanoFotoPerfil": 512
  },
  "EmailSettings": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "SecureSocket": "StartTls",
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Gestión de Turnos",
    "ReplyToAddress": "",
    "TimeoutSeconds": 30,
    "PickupDirectory": ""
  },
  "Notificaciones": {
    "Habilitado": true,
    "NombreSistema": "Gestión de Turnos",
    "UrlAplicacion": "http://localhost:4200",
    "CapacidadCola": 1000,
    "MaximoReintentos": 3,
    "GradoParalelismo": 2,
    "Eventos": {
      "RegistroAprobado": true,
      "RegistroRechazado": true,
      "TurnosPublicados": true,
      "TurnoModificado": true,
      "TurnoAnulado": true,
      "VacacionesResueltas": true,
      "VacacionesAnuladas": true,
      "NovedadResuelta": true,
      "CambioTurnoResuelto": true
    },
    "ReporteSemanal": {
      "Habilitado": true,
      "DiaEnvio": "Monday",
      "HoraEnvio": "07:00",
      "EnviarSinActividad": false
    }
  },
  "DosPasos": {
    "Disponible": false,
    "LongitudCodigo": 6,
    "MinutosVigencia": 5,
    "MaximoIntentos": 5,
    "SegundosEsperaReenvio": 60,
    "MaximoReenvios": 3
  }
}
